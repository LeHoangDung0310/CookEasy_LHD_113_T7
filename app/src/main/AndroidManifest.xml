<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CookEasy_LHD_113_T7"
        tools:targetApi="31">
        
        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Đăng nhập Activity - Launcher -->
        <activity
            android:name=".DangNhapActivity"
            android:exported="false"
            android:theme="@style/Theme.CookEasy_LHD_113_T7">
        </activity>
        
        <!-- Đăng ký Activity -->
        <activity
            android:name=".DangKyActivity"
            android:exported="false"
            android:theme="@style/Theme.CookEasy_LHD_113_T7" />
            
        <!-- Quên mật khẩu Activity -->
        <activity
            android:name=".QuenMatKhauActivity"
            android:exported="false"
            android:theme="@style/Theme.CookEasy_LHD_113_T7" />
            
        <!-- Trang chủ Activity -->
        <activity
            android:name=".TrangChuActivity"
            android:exported="false"
            android:theme="@style/Theme.CookEasy_LHD_113_T7" />
            
        <!-- Thông tin tài khoản Activity -->
        <activity
            android:name=".ThongTinTaiKhoanActivity"
            android:exported="false"
            android:theme="@style/Theme.CookEasy_LHD_113_T7" />
            
        <!-- Danh sách nguyên liệu Activity -->
        <activity
            android:name=".DanhSachNguyenLieuActivity"
            android:exported="false"
            android:theme="@style/Theme.CookEasy_LHD_113_T7" />
            
        <!-- Sắp hết hạn Activity -->
        <activity
            android:name=".SapHetHanActivity"
            android:exported="false"
            android:theme="@style/Theme.CookEasy_LHD_113_T7" />
            
        <!-- Danh sách món ăn Activity -->
        <activity
            android:name=".DanhSachMonAnActivity"
            android:exported="false"
            android:theme="@style/Theme.CookEasy_LHD_113_T7" />
            
        <!-- Chọn nguyên liệu Activity -->
        <activity
            android:name=".ChonNguyenLieuActivity"
            android:exported="false"
            android:theme="@style/Theme.CookEasy_LHD_113_T7" />
            
        <!-- Thêm nguyên liệu Activity -->
        <activity
            android:name=".ThemNguyenLieuActivity"
            android:exported="false"
            android:theme="@style/Theme.CookEasy_LHD_113_T7" />
            
        <!-- Thêm món ăn Activity -->
        <activity
            android:name=".ThemMonAnActivity"
            android:exported="false"
            android:theme="@style/Theme.CookEasy_LHD_113_T7" />

    </application>

</manifest>